<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the vCGE icon: "Quick Scan" (it can be dragged out as an icon of its own). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="quick_scan" android:enabled="true"
        android:icon="@drawable/ic_quick_scan_shortcut"
        android:shortcutShortLabel="@string/quick_scan"
        android:shortcutLongLabel="@string/quick_scan_long">
        <intent android:action="app.vcge.vcge.QUICK_SCAN"
            android:targetPackage="app.vcge.vcge" android:targetClass="app.vcge.vcge.MainActivity"/>
    </shortcut>
</shortcuts>
