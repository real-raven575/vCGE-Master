<?xml version="1.0" encoding="utf-8"?>
<!-- 2 x 1 by default, resizable; never updates on a timer (it only ever shows the button). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp" android:minHeight="40dp"
    android:targetCellWidth="2" android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_quick_scan"
    android:previewLayout="@layout/widget_quick_scan"
    android:previewImage="@drawable/ic_quick_scan_shortcut"
    android:description="@string/quick_scan_widget_description"
    android:widgetCategory="home_screen"/>
