<?xml version="1.0" encoding="utf-8"?>
<!-- vCGE Android wrapper (Tauri). No internet, ever: there is NO android.permission.INTERNET here, so the app cannot open
     a network socket at all. The pages load from inside the APK (Tauri serves them to the WebView itself).
     Debug builds add INTERNET back only to reach the dev server (src/debug/AndroidManifest.xml); release builds never.
     CAMERA is the one permission: scanning a card. Android asks the person the first time the app opens the camera. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The camera is optional: a phone or tablet without one can still upload a photo. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- allowBackup off: vCGE keeps nothing but its settings, and those stay on this device. -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.vcge"
        android:allowBackup="false"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Quick Scan (2026-11-24): the long-press shortcut, the widget and the pulldown tile open the app with this. -->
            <intent-filter>
                <action android:name="app.vcge.vcge.QUICK_SCAN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Quick Scan home-screen widget: one themed button. Adds no permission. -->
        <receiver
            android:name=".QuickScanWidget"
            android:label="@string/quick_scan"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/quick_scan_widget_info" />
        </receiver>

        <!-- Quick Scan pulldown tile. BIND_QUICK_SETTINGS_TILE is what the system holds to show the tile, not an app permission. -->
        <service
            android:name=".QuickScanTile"
            android:label="@string/quick_scan"
            android:icon="@drawable/ic_quick_scan"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="false" />
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
